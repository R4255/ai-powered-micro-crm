# ollama | gemini | rules  (ollama is the tested setup; gemini is supported but untested)
LLM_PROVIDER=ollama
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Used for meaning-based search: ollama pull nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text
# "Today" for the app. Sample data ends 2026-08-31.
AS_OF_DATE=2026-09-01

# Email: "outbox" stores emails locally only (nothing is sent).
# "smtp" is a placeholder for real sending; implement it in app/email_sender.py first.
EMAIL_PROVIDER=outbox
EMAIL_FROM=you@yourbusiness.example
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
